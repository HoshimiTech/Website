# ==========================================
# Security Headers
# ==========================================

/*
  # XSS保護 - ブラウザのXSSフィルターを有効化
  X-XSS-Protection: 1; mode=block
  
  # クリックジャッキング対策 - iframe内での表示を防止
  X-Frame-Options: DENY
  
  # MIME-type sniffingを無効化
  X-Content-Type-Options: nosniff
  
  # Referrer情報の制御
  Referrer-Policy: strict-origin-when-cross-origin

  # 権限の制限
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), usb=(), xr-spatial-tracking=()

  # Content Security Policy
  Content-Security-Policy:
    default-src 'self';
    base-uri 'self';
    frame-ancestors 'none';
    form-action 'self';
    object-src 'none';
    script-src 'self' https://static.cloudflareinsights.com https://cdn.credly.com;
    style-src 'self' 'unsafe-inline' https://fonts.gstatic.com;
    img-src 'self' data:;
    font-src 'self' data: https://fonts.gstatic.com;
    connect-src 'self';
    frame-src https://www.credly.com;
    worker-src 'none';
    manifest-src 'none';
    media-src 'none';
    upgrade-insecure-requests;

# ==========================================
# Cache
# ==========================================

/*.html
  Cache-Control: no-cache, must-revalidate

# CSSファイルのキャッシュ設定 - 1日間キャッシュ
/*.css
  Cache-Control: public, max-age=86400

# JavaScriptファイルのキャッシュ設定 - 1日間キャッシュ
/*.js
  Cache-Control: public, max-age=86400

# 静的アセット用のキャッシュ設定
/images/*
  Cache-Control: public, max-age=31536000, immutable

# ==========================================
# Link Headers
# ==========================================

/
  Link: </.well-known/api-catalog>; rel="api-catalog", </docs/api>; rel="service-doc", </openapi.json>; rel="service-desc", </.well-known/oauth-protected-resource>; rel="describedby"

/index.html
  Link: </.well-known/api-catalog>; rel="api-catalog", </docs/api>; rel="service-doc", </openapi.json>; rel="service-desc", </.well-known/oauth-protected-resource>; rel="describedby"

# ==========================================
# Content Types
# ==========================================

/.well-known/api-catalog
  Content-Type: application/linkset+json; charset=utf-8

/.well-known/openid-configuration
  Content-Type: application/json; charset=utf-8

/.well-known/oauth-protected-resource
  Content-Type: application/json; charset=utf-8

/.well-known/mcp/server-card.json
  Content-Type: application/json; charset=utf-8

/.well-known/agent-skills/index.json
  Content-Type: application/json; charset=utf-8

/.well-known/agent-skills/site-discovery/SKILL.md
  Content-Type: text/markdown; charset=utf-8

/docs/api
  Content-Type: text/html; charset=utf-8

/openapi.json
  Content-Type: application/json; charset=utf-8

/healthz
  Content-Type: application/json; charset=utf-8